# Supabase — get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Daily.co — get from daily.co dashboard (your subdomain, not full URL)
NEXT_PUBLIC_DAILY_DOMAIN=your-subdomain

# GitHub — personal access token (read:packages scope is enough)
# Get from github.com/settings/tokens
GITHUB_TOKEN=github_pat_xxxx
